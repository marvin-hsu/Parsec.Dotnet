<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />

    <!-- The package ships against the abstractions; the tests need a container to build. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Parsec.Client.DependencyInjection/Parsec.Client.DependencyInjection.csproj" />

    <!-- The integration test registers a client against the real service in a container. -->
    <ProjectReference Include="../../src/Parsec.Testcontainers/Parsec.Testcontainers.csproj" />
  </ItemGroup>

</Project>
