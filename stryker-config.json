{
  "stryker-config": {
    "project": "Parsec.Testcontainers.csproj",
    "target-framework": "net10.0",
    "test-runner": "mtp",
    "reporters": ["progress", "html", "json"],
    "mutate": [
      "**/ParsecConfigFile.cs",
      "**/ParsecSocketPath.cs",
      "**/ParsecHostSocketDirectory.cs",
      "**/ParsecSocketBridge.cs"
    ],
    "ignore-methods": [
      "ConfigureAwait",
      "*Exception.ctor",
      "string.Format"
    ],
    "thresholds": {
      "high": 90,
      "low": 80,
      "break": 0
    }
  }
}
