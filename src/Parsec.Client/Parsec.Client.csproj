<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Parsec.Client</RootNamespace>
    <AssemblyName>Parsec.Client</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Parsec.Client</PackageId>
    <Description>.NET client for Parsec (Platform AbstRaction for SECurity) — a platform-agnostic interface to hardware-backed security services.</Description>
    <PackageTags>parsec;security;hsm;tpm;pkcs11;crypto;cncf</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- SourceLink needs a git remote; enable it only in CI so fresh local clones still build -->
  <ItemGroup Condition="'$(CI)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Wire-protocol messages come from the upstream parsec-operations submodule and are compiled
       by protoc at build time. They stay internal: the public API of this library is hand-written. -->
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <Protobuf Include="$(MSBuildThisFileDirectory)../../external/parsec-operations/protobuf/*.proto"
              ProtoRoot="$(MSBuildThisFileDirectory)../../external/parsec-operations/protobuf"
              GrpcServices="None"
              Access="Internal" />
  </ItemGroup>

  <!-- Fail fast with a readable message when the submodule has not been checked out -->
  <Target Name="EnsureParsecOperationsSubmodule" BeforeTargets="Protobuf_BeforeCompile;CoreCompile">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../../external/parsec-operations/protobuf/ping.proto')"
           Text="The parsec-operations submodule is missing. Run: git submodule update --init" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Parsec.Client.Tests" />
  </ItemGroup>

</Project>
