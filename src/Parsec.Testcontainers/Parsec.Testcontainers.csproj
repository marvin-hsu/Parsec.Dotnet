<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Parsec.Testcontainers</RootNamespace>
    <AssemblyName>Parsec.Testcontainers</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Parsec.Testcontainers</PackageId>
    <Description>Testcontainers module that starts a Parsec service in a container for integration tests.</Description>
    <PackageTags>parsec;testcontainers;docker;integration-testing;security;hsm;tpm;cncf</PackageTags>
    <!-- No IsAotCompatible here. Testcontainers uses Docker.DotNet, which serialises with
         reflection, so the trim and AOT analysers cannot prove this assembly safe. -->
  </PropertyGroup>

  <!-- SourceLink needs a git remote; enable it only in CI so fresh local clones still build -->
  <ItemGroup Condition="'$(CI)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Parsec.Testcontainers.Tests" />
  </ItemGroup>

</Project>
