<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Parsec.Testcontainers</RootNamespace>
    <AssemblyName>Parsec.Testcontainers</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Parsec.Testcontainers</PackageId>
    <Description>Testcontainers module that starts a Parsec service in a container for integration tests.</Description>
    <PackageTags>testcontainers;parsec;docker;integration-testing</PackageTags>
    <!-- No IsAotCompatible here. Testcontainers uses Docker.DotNet, which serialises with
         reflection, so the trim and AOT analysers cannot prove this assembly safe. -->
  </PropertyGroup>

  <!-- SourceLink needs a git remote; enable it only in CI so fresh local clones still build -->
  <ItemGroup Condition="'$(CI)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <!-- Every public member must be listed in PublicAPI.Unshipped.txt, and moves to
       PublicAPI.Shipped.txt when a version ships. RS0016 then fails the build on a public
       member that nobody declared, and RS0017 fails it on one that was removed. Warnings are
       errors here, so a change to the package surface cannot reach a release unnoticed. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- MinVer reads the version from the nearest git tag. Each packable project has its own
       tag prefix, so the two packages release on separate cadences: a testcontainers-v* tag
       moves this version only, and Parsec.Client keeps the version it has. With no matching
       tag MinVer falls back to 0.0.0-alpha.0 plus the commit height. -->
  <PropertyGroup>
    <MinVerTagPrefix>testcontainers-v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <!-- This package has its own README. The repository README describes both packages.
       The file is excluded from the default None glob and included with a full path,
       because pack collects the package files in the outer build, where the default
       globs are not populated. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);README.md</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Parsec.Testcontainers.Tests" />
  </ItemGroup>

</Project>
