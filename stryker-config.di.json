{
  "stryker-config": {
    "project": "Parsec.Client.DependencyInjection.csproj",
    "target-framework": "net10.0",
    "test-runner": "mtp",
    "reporters": ["progress", "html", "json"],
    "mutate": [
      "**/src/Parsec.Client.DependencyInjection/**/*.cs",
      "!**/artifacts/**/*.cs",
      "!**/obj/**/*.cs"
    ],
    "ignore-methods": [
      "ConfigureAwait",
      "*Exception.ctor",
      "string.Format"
    ],
    "thresholds": {
      "high": 90,
      "low": 80,
      "break": 0
    }
  }
}
